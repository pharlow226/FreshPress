# ============================================================
# FRESHPRESS — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — only commit .env.example
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Edge Function endpoints ────────────────────────────────────
# Replace your-project-ref with your Supabase project reference ID
VITE_CREATE_ORDER_URL=https://your-project-ref.supabase.co/functions/v1/create-order
VITE_CREATE_STAFF_URL=https://your-project-ref.supabase.co/functions/v1/create-staff
VITE_DELETE_STAFF_URL=https://your-project-ref.supabase.co/functions/v1/delete-staff
VITE_UPDATE_STAFF_URL=https://your-project-ref.supabase.co/functions/v1/update-staff
VITE_REASSIGN_ORDER_URL=https://your-project-ref.supabase.co/functions/v1/reassign-order
VITE_MARK_ORDER_DELAYED_URL=https://your-project-ref.supabase.co/functions/v1/mark-order-delayed
VITE_MARK_PICKED_UP_URL=https://your-project-ref.supabase.co/functions/v1/mark-picked-up
VITE_GENERATE_INVOICE_URL=https://your-project-ref.supabase.co/functions/v1/generate-invoice
VITE_MARK_DELIVERED_URL=https://your-project-ref.supabase.co/functions/v1/mark-delivered
VITE_CONFIRM_PAYMENT_URL=https://your-project-ref.supabase.co/functions/v1/confirm-payment
VITE_SAVE_COMPANY_SETTINGS_URL=https://your-project-ref.supabase.co/functions/v1/save-company-settings
VITE_FORGOT_PASSWORD_URL=https://your-project-ref.supabase.co/functions/v1/forgot-password
VITE_RESET_PASSWORD_URL=https://your-project-ref.supabase.co/functions/v1/reset-password
VITE_CHAT_ASSISTANT_URL=https://your-project-ref.supabase.co/functions/v1/chat-assistant

# ── n8n (legacy webhooks — will be phased out) ────────────────
VITE_N8N_ORDER_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/customer-pickup-order
VITE_N8N_INVOICE_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/generate-invoice

# ══════════════════════════════════════════════════════════════
# BACKEND SECRETS — Set these in Supabase Edge Function Secrets
# Supabase Dashboard → Edge Functions → [function] → Secrets
# These are NEVER prefixed with VITE_ and never exposed to the browser
# ══════════════════════════════════════════════════════════════

# ── Supabase Service Role (bypasses RLS — server-side only) ───
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── OpenAI (chat-assistant Edge Function) ─────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Brevo (transactional email + CRM) ─────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@email.com
BREVO_LIST_ID=your_brevo_list_id_here

# ── Resend (alternative email — order confirmation, invoice) ───
RESEND_API_KEY=your_resend_api_key_here

# ── Evolution API (WhatsApp notifications) ────────────────────
# EVOLUTION_API_URL=https://your-evolution-instance.com
# EVOLUTION_API_KEY=your_evolution_api_key
# EVOLUTION_INSTANCE_NAME=freshpress

# ── Admin setup secret — Supabase Edge Function Secret ONLY ───
# Do NOT add VITE_ prefix — set this in:
# Supabase Dashboard → Edge Functions → create-staff → Secrets → SETUP_SECRET
# SETUP_SECRET=your_strong_secret_here
